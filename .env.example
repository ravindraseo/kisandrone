# Copy to .env.local for local development, or set these in your hosting provider.

# Public URL of the live site (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.kisandrone.co.in

# Set to "false" on staging/preview deployments so search engines don't index them.
NEXT_PUBLIC_ALLOW_INDEXING=true
